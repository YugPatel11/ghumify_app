# ==============================================================================
# Ghumify Flutter Environment Configuration
# ==============================================================================

# Backend AI & Places Router
AI_ROUTER_ENABLED=false
BACKEND_BASE_URL=http://10.0.2.2:3000

# Local Rule-Based Chat Fallback (Tier 4)
LOCAL_CHAT_FALLBACK_ENABLED=false
# Developer-only flag to force local chat tier for testing
FORCE_LOCAL_CHAT=false

# Google Maps & Places
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=your_open_weather_key_here

# Google Cloud Translation
GOOGLE_TRANSLATE_API_KEY=your_google_translate_key_here

# Google Gemini API Keys (Failover rotation)
GEMINI_API_KEY_1=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
